# REQUIRED
OPENAI_API_KEY=
EXA_API_KEY=

# STRONGLY RECOMMENDED (fallback if OpenAI rate-limits during the live demo)
OPENROUTER_API_KEY=

# Real, currently-available OpenAI model string — the code default is an
# unverified placeholder, set this explicitly once you've checked.
LLM_MODEL=

# CORS: origin of the browser extension calling this backend. "*" is fine
# for a hackathon demo (no cookies/auth in scope) — see src/middleware.ts.
EXTENSION_ORIGIN=*

# OPTIONAL — CopilotKit Intelligence Platform (runtime falls back to SSE without it)
CPK_INTELLIGENCE_API_KEY=

# OPTIONAL STRETCH — Trigger.dev background jobs
TRIGGER_PROJECT=
TRIGGER_SECRET_KEY=

# OPTIONAL STRETCH — Postgres persistence (app runs fully without it)
DATABASE_URL=
