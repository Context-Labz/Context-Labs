# REQUIRED for live LLM extraction (OpenRouter). Leave blank to use the built-in
# heuristic extractor + research corpus — the product still runs.
OPENROUTER_API_KEY=

# Optional OpenAI fallback if OpenRouter rate-limits.
OPENAI_API_KEY=

# Model string in OpenRouter format, e.g. openai/gpt-4o-mini
LLM_MODEL=openai/gpt-4o-mini

# Optional live web search. Leave blank to use the bundled research corpus.
EXA_API_KEY=

# CORS: origin of the browser extension. "*" is fine for local/demo.
EXTENSION_ORIGIN=*
