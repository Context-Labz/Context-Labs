# REQUIRED — OpenRouter is the primary LLM provider (we have working credits)
OPENROUTER_API_KEY=your_openrouter_key_here
EXA_API_KEY=your_exa_key_here

# TWO model vars, and they are NOT interchangeable:
#
#   LLM_MODEL           — used by lib/llm.ts and lib/agent/run-research.ts,
#                         which now call OpenRouter through the OpenAI SDK.
#                         OpenRouter requires a PROVIDER-PREFIXED string.
#   COPILOT_AGENT_MODEL — used by the CopilotKit BuiltInAgent in
#                         /api/copilotkit. Also provider-prefixed, but drawn
#                         from CopilotKit's own fixed model enum, which is NOT
#                         the same list as OpenRouter's catalogue.
#
# They used to share LLM_MODEL. Keep them separate: the two paths validate
# their model strings against different lists, so one var cannot satisfy both.
LLM_MODEL=openai/gpt-4o-mini
COPILOT_AGENT_MODEL=openai/gpt-4o-mini

# OPTIONAL — override the OpenAI-compatible endpoint the CHAT agent uses.
# Defaults to OpenRouter. Point it at any OpenAI-compatible server (a proxy,
# a local model) without touching code.
OPENROUTER_BASE_URL=

# OPTIONAL — Standard OpenAI API. NOT required: with OPENROUTER_API_KEY set,
# BOTH paths (lib/llm.ts and the CopilotKit chat agent) go through OpenRouter.
# Set this only if you have working OpenAI credits; lib/llm.ts then uses it as
# a 429 fallback, and the chat agent falls back to it if OpenRouter is unset.
OPENAI_API_KEY=

# CORS: origin of the browser extension calling this backend. "*" is fine
# for a hackathon demo (no cookies/auth in scope) — see src/middleware.ts.
EXTENSION_ORIGIN=*

# OPTIONAL — CopilotKit Intelligence Platform (runtime falls back to SSE without it)
CPK_INTELLIGENCE_API_KEY=

# OPTIONAL STRETCH — Trigger.dev background jobs
TRIGGER_PROJECT=
TRIGGER_SECRET_KEY=

# OPTIONAL STRETCH — Postgres persistence (app runs fully without it)
DATABASE_URL=
