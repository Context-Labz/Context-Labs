OPENAI_API_KEY=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
EXA_API_KEY=5f47fdcc-a679-457b-8b74-b79972f96fe7


# STRONGLY RECOMMENDED (fallback if OpenAI rate-limits during the live demo)
OPENROUTER_API_KEY=

# TWO model vars, and they are NOT interchangeable:
#
#   LLM_MODEL           — bare OpenAI model name, for the OpenAI SDK calls in
#                         lib/llm.ts (plan/extract/report). No provider prefix.
#   COPILOT_AGENT_MODEL — provider-PREFIXED string, for the CopilotKit chat
#                         agent in /api/copilotkit. A bare name here makes every
#                         chat run fail with: Invalid model string "...".
#
# They used to share LLM_MODEL, which cannot satisfy both formats.
LLM_MODEL=gpt-4o-mini
COPILOT_AGENT_MODEL=openai/gpt-4o-mini

# CORS: origin of the browser extension calling this backend. "*" is fine
# for a hackathon demo (no cookies/auth in scope) — see src/middleware.ts.
EXTENSION_ORIGIN=*

# OPTIONAL — CopilotKit Intelligence Platform (runtime falls back to SSE without it)
CPK_INTELLIGENCE_API_KEY=

# OPTIONAL STRETCH — Trigger.dev background jobs
TRIGGER_PROJECT=
TRIGGER_SECRET_KEY=

# OPTIONAL STRETCH — Postgres persistence (app runs fully without it)
DATABASE_URL=
