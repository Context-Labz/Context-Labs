# REQUIRED — OpenRouter is the primary LLM provider (we have working credits)
OPENROUTER_API_KEY=YK2YS5YPY2ZXZ9GZ 
EXA_API_KEY=AITAGENTSHACK

# Model string in OpenRouter format: "provider/model" (e.g., "openai/gpt-4o-mini").
# The default is gpt-4o-mini via OpenRouter; override if you want a different model.
LLM_MODEL=openai/gpt-4o-mini

# OPTIONAL — Standard OpenAI API (we don't have working credits for this, only Codex).
# Only set this if you have a working OpenAI API key; it's used as a fallback.
OPENAI_API_KEY=

# CORS: origin of the browser extension calling this backend. "*" is fine
# for a hackathon demo (no cookies/auth in scope) — see src/middleware.ts.
EXTENSION_ORIGIN=*

# OPTIONAL — CopilotKit Intelligence Platform (runtime falls back to SSE without it)
CPK_INTELLIGENCE_API_KEY=

# OPTIONAL STRETCH — Trigger.dev background jobs
TRIGGER_PROJECT=
TRIGGER_SECRET_KEY=

# OPTIONAL STRETCH — Postgres persistence (app runs fully without it)
DATABASE_URL=
